{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/queue/cleanup",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/release-abandoned-checkouts",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/generate-invoices",
      "schedule": "0 9 1 * *"
    },
    {
      "path": "/api/cron/annual-renewal-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/lux-retention",
      "schedule": "30 7 * * *"
    }
  ]
}
